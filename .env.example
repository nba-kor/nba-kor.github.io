# 팀원모집 API(Supabase Edge Function 'recruit') 설정. 복사해서 .env 로 쓴다 — .env 는 커밋되지 않는다.
#   cp .env.example .env
# Node 서버 시절에 만든 .env(PORT · TRUST_PROXY · 빈 CORS_ORIGIN · localhost SITE_URL)는 이걸로 다시 만든다 — 그대로 올리면 운영 화면이 API 응답을 못 읽는다.
# 운영: 함수 비밀값으로 올린다(README "운영 배포"). SUPABASE_ 로 시작하는 줄은 CLI 가 건너뛴다. 아래 SUPABASE_ACCESS_TOKEN 이 있어야 CLI 가 돈다.
#   npx supabase secrets set --project-ref lgchgqxjjlapszmxarun --env-file .env
# 로컬: docker compose 는 이 파일에서 DISCORD_* 만 api 서비스에 끼워 넣는다(CORS_ORIGIN · SITE_URL · Supabase 주소 · 키 · 로컬 봇 키는 compose.yaml 값).
# SUPABASE_URL · SUPABASE_SECRET_KEYS · SUPABASE_PUBLISHABLE_KEYS 는 Supabase 가 함수에 직접 넣어 준다 — 여기 적지 않는다(SUPABASE_ 로 시작하는 비밀값은 올릴 수도 없다).

# 배포용 개인 토큰(https://supabase.com/dashboard/account/tokens, sbp_...). 이 PC 의 CLI 만 쓴다 — 함수 비밀값 · 저장소에 넣지 말 것
SUPABASE_ACCESS_TOKEN=

# 화면 주소(쉼표로 여러 개). 이 Origin 에서 온 브라우저 요청만 API 응답을 읽을 수 있다
CORS_ORIGIN=https://nba-kor.github.io
# 알림 속 링크·썸네일 기준 주소
SITE_URL=https://nba-kor.github.io

# 디스코드 채널 설정 > 연동 > 웹후크 URL. 비우면 알림을 보내지 않는다
DISCORD_WEBHOOK_URL=
# 음성채널 배정용 봇 (Developer Portal > Bot > Token). 토큰·서버 ID 둘 다 있어야 켜진다
DISCORD_BOT_TOKEN=
# 서버 ID (개발자 모드 켜고 서버 아이콘 우클릭 > ID 복사)
DISCORD_GUILD_ID=
# 이 카테고리 안의 음성채널만 배정. 비우면 서버의 모든 음성채널
DISCORD_VOICE_CATEGORY_ID=

# TNAB 디스코드 봇이 API 를 부를 때 쓰는 키(32자 이상). 비우면 봇 요청은 전부 401. 만들기: openssl rand -base64 33
# 봇 PC 의 .env 에도 같은 값을 넣는다. 채팅 · 저장소 · 인계 문서에 붙여 넣지 않는다 — 새면 누구나 아무 디스코드 ID 로 파티를 만들고 해제할 수 있다(바꾸면 secrets set 만 다시)
TNAB_BOT_KEY=
