# 팀원모집 API(server/index.mjs) 설정. 복사해서 .env 로 쓴다 — .env 는 커밋되지 않는다.
#   cp .env.example .env
# docker compose 는 이 파일을 api 서비스에 넘기고, PORT·TRUST_PROXY·SUPABASE_URL·SUPABASE_SECRET_KEY 는 compose 가 덮어쓴다
# (로컬은 compose 안의 Supabase 흉내 db + rest 를 쓰므로 아래 Supabase 값은 운영 서버에서만 채운다.
#  그 로컬 Data API 는 이 PC 의 http://localhost:54321 에만 열린다 — 사이트 :8000 에는 없다).

PORT=3000
# Supabase 프로젝트 URL — https://<project-ref>.supabase.co
SUPABASE_URL=
# Supabase 대시보드 > Project Settings > API Keys 의 secret key (sb_secret_...). 서버 전용 —
# 브라우저·저장소에 넣지 말 것(GitHub 에 올라가면 Supabase 가 자동 폐기한다)
SUPABASE_SECRET_KEY=
# 알림 속 링크·썸네일 기준 주소 (운영: https://nba-kor.github.io)
SITE_URL=http://localhost:8000
# 운영에서 API 가 다른 도메인이면 https://nba-kor.github.io — 비우면 CORS 헤더를 붙이지 않는다
CORS_ORIGIN=
# nginx 같은 프록시 뒤면 1 (X-Forwarded-For 첫 주소로 요청 수 제한). 프록시 없이 열면 0 — 헤더 위조를 막는다
TRUST_PROXY=0

# 디스코드 채널 설정 > 연동 > 웹후크 URL. 비우면 알림을 보내지 않는다
DISCORD_WEBHOOK_URL=
# 음성채널 배정용 봇 (Developer Portal > Bot > Token). 토큰·서버 ID 둘 다 있어야 켜진다
DISCORD_BOT_TOKEN=
# 서버 ID (개발자 모드 켜고 서버 아이콘 우클릭 > ID 복사)
DISCORD_GUILD_ID=
# 이 카테고리 안의 음성채널만 배정. 비우면 서버의 모든 음성채널
DISCORD_VOICE_CATEGORY_ID=
